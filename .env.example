# Automatically read by python -m workflow. Real .env is ignored by Git.
# Existing terminal environment variables take precedence.
# Model provider for Interview, Negotiator and Idea: deepseek or openai.
PI_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# OpenAI: set PI_PROVIDER=openai, OPENAI_API_KEY and an explicit OPENAI_MODEL.
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# PI_MODEL is also accepted as an OpenAI model identifier.
# PI_MODEL=

# Evaluator follows PI_PROVIDER when omitted. Optional independent override:
# EVALUATOR_PROVIDER=deepseek
# If omitted, evaluator reuses the selected provider's model.
# EVALUATOR_MODEL=deepseek-flash
# Switching an existing .env to OpenAI also requires removing/changing any
# explicit EVALUATOR_PROVIDER / EVALUATOR_MODEL / EVALUATOR_BASE_URL overrides.
# Tavily powers real web search/read for BOTH model providers.
EVALUATOR_RETRIEVAL=api
TAVILY_API_KEY=
# Optional: EVALUATOR_MAX_TOKENS=4096
# Optional: EVALUATOR_OFFICIAL_DOMAINS=spacetimedb.com,fetch.ai,agentverse.ai,api-docs.deepseek.com,ai.google.dev,docs.tavily.com

# Durable cloud store (omit for local SQLite). Never commit a real URL.
# DATABASE_URL=

# Live shared-key access is closed unless a demo access code is configured.
# CONCLAVE_DEMO_ACCESS_CODE=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable across deployments. It encrypts per-room user keys.
# CONCLAVE_SECRET_KEY=
CONCLAVE_SHARED_DAILY_CALLS=120
CONCLAVE_ROOM_CALL_LIMIT=80
# Enable only behind a trusted proxy that appends the actual client address.
# CONCLAVE_TRUST_PROXY=1
