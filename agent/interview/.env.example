# Copy to .env locally; .env is ignored by Git. Offline commands do not read it.
PI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Current official docs list deepseek-flash / deepseek-v4-pro; verify again for live tests.
DEEPSEEK_MODEL=deepseek-flash
# To use OpenAI, set PI_PROVIDER=openai and configure both:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
